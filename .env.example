# ---------------------------------------------------------------------------
# JARVIS-MARK5 environment
# Copy to `.env` and fill in. jarvis.py reads these at import time and will
# raise KeyError on startup if InputLanguage / NickName are missing.
# ---------------------------------------------------------------------------

# Required by jarvis.py (os.environ[...] - no default, startup fails without)
InputLanguage=en
NickName=Sir
AssistantName=Jarvis

# Required by backend/modules/search.py
SERPER_API_KEY=

# PostgreSQL - used by backend/modules/llms.py for conversation history.
# Defaults shown are the ones hardcoded in llms.py.
DB_NAME=memory_agent
DB_USER=admin
DB_PASSWORD=admin
DB_HOST=localhost
DB_PORT=5432
