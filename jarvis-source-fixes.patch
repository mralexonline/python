-    import os
-    os.chdir("backend/AI/Perplexica")
-    os.system("docker compose up -d")
+    # NOTE: this previously used os.chdir(), which changes the working
+    # directory for the WHOLE process, not just this thread. It raced with the
+    # main thread's LoadMessages() call and made the relative path to
+    # ChatLog.json resolve against the Perplexica directory, so startup failed
+    # with FileNotFoundError. Passing cwd= keeps the change local to the
+    # subprocess.
+    import subprocess
+    try:
+        subprocess.run(
+            ["docker", "compose", "up", "-d"],
+            cwd=os.path.join(os.path.dirname(os.path.abspath(__file__)),
+                             "backend", "AI", "Perplexica"),
+            check=False,
+        )
+    except FileNotFoundError:
+        print("Perplexica not started: docker is not installed or not on PATH.")
 
 thread = threading.Thread(target=run_docker)
 thread.start()
